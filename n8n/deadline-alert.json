{
  "id": "gapmapDeadline03",
  "name": "GapMap - 마감 D-3 알림 (매일 09:00)",
  "active": false,
  "settings": { "timezone": "Asia/Seoul", "executionOrder": "v1" },
  "nodes": [
    {
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "매일 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "days", "triggerAtHour": 9 }] } }
