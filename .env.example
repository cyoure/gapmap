# 이 파일을 .env로 복사해서 사용하세요:  cp .env.example .env
# .env는 .gitignore에 있으므로 커밋되지 않습니다.

# --- Ollama ---
# 컨테이너끼리는 localhost가 아니라 compose 서비스 이름(ollama)으로 접근합니다.
OLLAMA_BASE_URL=http://ollama:11434
# 개발: qwen2.5:3b (CPU) / 시연: qwen2.5:7b
OLLAMA_MODEL=qwen2.5:3b

# 임베딩 모델 (다국어 — 한국어 이력서 검색용)
EMBED_MODEL=bge-m3

# --- 이력서 ---
# 호스트의 ./data 가 컨테이너 /data 로 읽기 전용 마운트됨
RESUME_DIR=/data/resume

# --- Chroma ---
# 컨테이너 내부 포트는 8000 (호스트에는 8001로 노출)
CHROMA_URL=http://chroma:8000

# --- PostgreSQL ---
# compose가 이 값으로 DB를 만들고, api의 DATABASE_URL도 이 값으로 조립한다 (한 곳에서만 관리)
POSTGRES_USER=gapmap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gapmap

# Chroma 클라이언트 사용통계 전송 끄기 (로컬 전용 프로젝트)
ANONYMIZED_TELEMETRY=False

# --- GitHub MCP (Phase 4) ---
# 원격 GitHub MCP 서버. 토큰은 Fine-grained, Public repositories 읽기 전용 권장. 비우면 GitHub 도구만 빠짐
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_TOKEN=
GITHUB_USER=your-github-id
GITHUB_EXCLUDE_REPOS=gapmap
# 내가 참여한 팀(Organization) 저장소, 쉼표로 구분 (owner/repo). org 전체를 넣지 않는다
GITHUB_TEAM_REPOS=
